# Copy to ../.env (repo root) or mistral_wp_django/.env — settings load both.

# PostgreSQL (Django DATABASES default)
# Database: mistraldb   User: mistraldbuser
PGDATABASE=mistraldb
PGUSER=mistraldbuser
PGPASSWORD=your_password
PGHOST=localhost
PGPORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Base URL for links in emails (one-click publish). Use public URL if you read mail on another device.
SITE_BASE_URL=http://127.0.0.1:8000

# Same as standalone scripts (repo root .env)
MISTRAL_API_KEY=
# Optional: Mistral API read timeout in milliseconds (default 300000 = 5 min)
# MISTRAL_TIMEOUT_MS=600000
# e.g. https://pvmehta.com (no trailing path)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Optional default category name when the form leaves category blank
WORDPRESS_DEFAULT_CATEGORY=

# --- Email (Gmail) ---
# If you see "Connection unexpectedly closed", try the OTHER block below (587+TLS vs 465+SSL).
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
NOTIFICATION_EMAIL=vaatrak@gmail.com
DEFAULT_FROM_EMAIL=youraccount@gmail.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=youraccount@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
EMAIL_TIMEOUT=60

# Option A — STARTTLS on 587 (common)
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Option B — Implicit SSL on 465 (try if Option A fails on your network / antivirus)
# EMAIL_PORT=465
# EMAIL_USE_TLS=false
# EMAIL_USE_SSL=true

# Local dev without SMTP (prints email body to the terminal)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
